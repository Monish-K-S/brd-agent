# Copy to .env and fill in real values. Never commit .env.
# Names match app/core/config.py Settings fields (case-insensitive).

# General
ENVIRONMENT=development
APP_NAME=BRD Agent API
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:5173

# Supabase (JWT verification via JWKS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Gmail + Drive integrations share one OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/integrations/drive/callback

# Token encryption (REQUIRED, fail-fast at boot if missing).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: decrypt rows with the old key and re-encrypt with the new one
# via a script; there is no multi-key support in-app.
TOKEN_ENCRYPTION_KEY=

# OAuth state signing (REQUIRED, fail-fast at boot if missing).
# Must be distinct from GOOGLE_CLIENT_SECRET (key separation).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/brd_agent

# AI providers (read via os.getenv in extractors/generators)
SARVAM_API_KEY=
GEMINI_API_KEY=

# Thinking budget for the single Gemini BRD call. Not 0: deciding whether
# two differently-worded requirements are the same needs reasoning, and
# that is the only dedup layer left after the consolidator removes exact
# repeats. Lower to 1024 for speed, 0 to disable, raise for messier input.
GEMINI_THINKING_BUDGET=2048
# Per-attempt HTTP ceiling for that call, plus one retry on 408/429/5xx.
GEMINI_TIMEOUT_SECONDS=120

# Ceiling for one Sarvam extraction job (polled every 2s). Raise this if
# large workspaces time out with "Sarvam extraction timed out".
SARVAM_TIMEOUT_SECONDS=180

# Upload limits (defaults shown; optional)
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=500000
MAX_PDF_PAGES=200

# Aggregate character budget across all of a workspace's sources when
# they are merged into the single project PDF sent to Sarvam. Sources
# beyond the budget have their tail truncated (marked in the PDF) and
# stay unextracted for a later run.
MAX_AGGREGATE_CHARS=1000000

# Generation jobs: a queued/running job untouched longer than this is
# treated as orphaned (server restart mid-run) and marked failed.
GENERATION_JOB_TIMEOUT_MINUTES=15

# Rate limiting (defaults shown; optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BRD_GENERATE=5/hour
RATE_LIMIT_BRD_ASK=30/minute
RATE_LIMIT_BRD_EXPORT=20/hour
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_GMAIL_SEARCH=30/minute
RATE_LIMIT_GMAIL_RECENT=30/minute
RATE_LIMIT_GMAIL_IMPORT=20/hour
RATE_LIMIT_GMAIL_CONNECT=10/hour
RATE_LIMIT_GMAIL_CALLBACK=20/minute
RATE_LIMIT_DRIVE_CONNECT=10/hour
RATE_LIMIT_DRIVE_CALLBACK=20/minute
RATE_LIMIT_DRIVE_PICKER_TOKEN=30/minute
RATE_LIMIT_DRIVE_IMPORT=20/hour

# Production hardening (optional)
# ALLOWED_HOSTS left empty defaults to ["*"], which makes
# TrustedHostMiddleware a no-op — set your real hostname(s) in production.
ALLOWED_HOSTS=
EXPOSE_DB_HEALTH=false

# CORS (comma-separated; default http://localhost:5173 if unset).
# Set to your production frontend origin(s) on deploy.
CORS_ORIGINS=http://localhost:5173
