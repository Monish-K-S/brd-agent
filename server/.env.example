# Copy to .env and fill in real values. Never commit .env.
# Names match app/core/config.py Settings fields (case-insensitive).

# General
ENVIRONMENT=development
APP_NAME=BRD Agent API
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:5173

# Supabase (JWT verification via JWKS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/brd_agent

# AI providers (read via os.getenv in extractors/generators)
SARVAM_API_KEY=
GEMINI_API_KEY=

# Upload limits (defaults shown; optional)
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=500000
MAX_PDF_PAGES=200

# Rate limiting (defaults shown; optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BRD_GENERATE=5/hour
RATE_LIMIT_CONSOLIDATE=10/hour
RATE_LIMIT_EXTRACT=10/hour
RATE_LIMIT_BRD_ASK=30/minute
RATE_LIMIT_BRD_EXPORT=20/hour
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_GMAIL_SEARCH=30/minute
RATE_LIMIT_GMAIL_RECENT=30/minute
RATE_LIMIT_GMAIL_IMPORT=20/hour
RATE_LIMIT_GMAIL_CONNECT=10/hour
RATE_LIMIT_GMAIL_CALLBACK=20/minute

# Production hardening (optional)
ALLOWED_HOSTS=
EXPOSE_DB_HEALTH=false
