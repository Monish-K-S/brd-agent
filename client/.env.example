# Copy to .env.local and fill in real values. Never commit .env.local.
# Vite bakes these in at build time (VITE_ prefix required).

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# NOTE: Security headers for the SPA (CSP, HSTS, X-Frame-Options) must be
# configured at the static host (e.g. vercel.json headers / netlify.toml),
# not in this repo. The API sets its own headers server-side.
